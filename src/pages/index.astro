---
import Base from "../layouts/Base.astro";
import IncomeTaxCalculator from "../components/calculators/IncomeTaxCalculator.svelte";
import IncomeTaxExplainer from "../components/IncomeTaxExplainer.astro";
import { DEFAULT_TAX_YEAR, TAX_YEARS } from "../lib/tax-engine";

const years = TAX_YEARS.map((y) => y.year);
const title = `Canada Income Tax Calculator ${DEFAULT_TAX_YEAR} — Take-Home Pay by Province | CalcTax`;
const description = `See your ${DEFAULT_TAX_YEAR} take-home pay in seconds: federal and provincial tax, CPP and EI for all 13 provinces and territories, line by line. Also covers ${years.filter((y) => y !== DEFAULT_TAX_YEAR).join(" and ")}. Free and private.`;
---

<Base title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
    <h1 class="text-[1.6rem] sm:text-[1.9rem] leading-tight font-extrabold tracking-tight text-ink max-w-3xl">
      Canadian income tax calculator
    </h1>
    <p class="mt-2 text-lg text-ink-2 max-w-2xl">
      Federal and provincial tax, CPP and EI for every province and territory. It all runs in your browser.
    </p>

    <div class="mt-8">
      <IncomeTaxCalculator client:load />
    </div>

    <div class="mt-24">
      <IncomeTaxExplainer />
    </div>
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: `Canada Income Tax Calculator ${DEFAULT_TAX_YEAR}`,
      url: "https://calctax.ca/",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
      description,
    })}
  />
</Base>
