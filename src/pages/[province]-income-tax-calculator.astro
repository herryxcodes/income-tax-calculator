---
import Base from "../layouts/Base.astro";
import IncomeTaxCalculator from "../components/calculators/IncomeTaxCalculator.svelte";
import PageIntro from "../components/PageIntro.astro";
import BracketTable from "../components/BracketTable.astro";
import {
  calculateTax,
  emptyInput,
  formatCurrency,
  formatPercent,
  formatRate,
  getProvinces,
  getTaxYear,
  topMarginalRate,
  DEFAULT_TAX_YEAR,
  type ProvinceTaxData,
} from "../lib/tax-engine";

export function getStaticPaths() {
  return getProvinces().map((p) => ({ params: { province: p.slug }, props: { province: p } }));
}

const { province } = Astro.props as { province: ProvinceTaxData };
const year = DEFAULT_TAX_YEAR;
const data = getTaxYear(year);
const isQuebec = province.slug === "quebec";
const money = (n: number) => `$${Math.round(n).toLocaleString("en-CA")}`;

const topRate = topMarginalRate(province.slug, year);
const topThreshold = Math.max(province.brackets[province.brackets.length - 1].min, data.federal.brackets[data.federal.brackets.length - 1].min);
const salaries = [40000, 50000, 60000, 75000, 100000, 150000];
const rows = salaries.map((s) => ({ salary: s, r: calculateTax({ ...emptyInput(province.slug, year), employmentIncome: s }) }));
const at75 = rows.find((x) => x.salary === 75000)!.r;

const title = `${province.name} Income Tax Calculator ${year} — Take-Home Pay | CalcTax`;
const description = `Estimate your ${year} ${province.name} income tax and take-home pay. Federal and ${province.abbreviation} tax, ${isQuebec ? "QPP, EI and QPIP" : "CPP and EI"}, line by line. Free and private.`;

const faqs = [
  {
    q: `What is the top tax rate in ${province.name}?`,
    a: `The top combined federal and ${province.name} rate on ordinary income in ${year} is ${formatPercent(topRate)}, on taxable income over ${money(topThreshold)}${province.surtax ? ", including Ontario's surtax" : ""}${isQuebec ? ", after the 16.5% federal abatement for Quebec residents" : ""}.`,
  },
  {
    q: `What is the basic personal amount in ${province.name}?`,
    a: `${province.name}'s basic personal amount for ${year} is ${money(province.basicPersonalAmount)}, worth a credit of ${formatRate(province.creditRate)} of that amount. The federal basic personal amount is ${money(data.federal.bpa.max)}.`,
  },
  {
    q: `How much tax do I pay on $75,000 in ${province.name}?`,
    a: `On a $75,000 salary in ${year} you pay about ${formatCurrency(at75.federalTax)} in federal tax, ${formatCurrency(at75.provincialTax)} in ${province.name} tax and ${formatCurrency(at75.contributions.total)} in ${isQuebec ? "QPP, EI and QPIP" : "CPP and EI"}, for take-home pay of ${formatCurrency(at75.afterTaxIncome)} (${formatCurrency(at75.afterTaxIncome / 12)} a month).`,
  },
];
---

<Base title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
    <PageIntro
      title={`${province.name} income tax calculator`}
      lede={`Your ${province.name} take-home pay after federal and provincial tax, ${isQuebec ? "QPP, EI and QPIP" : "CPP and EI"}.`}
      crumbs={[{ href: "/income-tax-calculator", label: "Income tax" }, { label: province.name }]}
    />
    <div class="mt-8">
      <IncomeTaxCalculator client:load initialProvince={province.slug} />
    </div>

    <section class="mt-24 prose">
      <h2>{province.name} tax brackets for {year}</h2>
      {data.status === "projected" && <p><strong>Projected:</strong> {data.statusNote}</p>}
      <BracketTable brackets={province.brackets} rateHeading={`${province.abbreviation} rate`} />
      <p>
        These rates apply on top of federal tax. The {province.name} basic personal amount is
        <strong>{money(province.basicPersonalAmount)}</strong>{province.bpaPhaseOut ? `, reduced for net income between ${money(province.bpaPhaseOut.start)} and ${money(province.bpaPhaseOut.end)}` : ""}.
        The top combined federal and provincial rate is <strong>{formatPercent(topRate)}</strong>.
      </p>
      {province.notes?.map((n) => <p>{n}</p>)}

      {province.ontario && (
        <>
          <h3>Ontario surtax, tax reduction and health premium</h3>
          <p>
            Ontario adds a surtax of 20% of provincial tax over {money(province.surtax![0].threshold)} and another 36% over
            {" "}{money(province.surtax![1].threshold)}. Lower-income residents get the Ontario tax reduction and the LIFT
            credit, which can bring provincial tax to zero. Everyone with taxable income over $20,000 also pays the
            Ontario Health Premium, up to $900 a year. The calculator includes all four.
          </p>
        </>
      )}
      {isQuebec && (
        <>
          <h3>Quebec's separate tax system</h3>
          <p>
            Quebec residents file two returns: a federal return with the CRA and a provincial return with Revenu Québec.
            Federal tax is reduced by the refundable Quebec abatement of 16.5%. Quebec has its own pension plan (QPP),
            a lower EI rate, and the Quebec Parental Insurance Plan (QPIP). The calculator handles all of these and the
            Quebec deduction for workers.
          </p>
        </>
      )}

      <h2>Take-home pay in {province.name} at common salaries</h2>
      <table>
        <thead>
          <tr><th>Salary</th><th>Total tax and contributions</th><th>Take-home</th><th>Per month</th></tr>
        </thead>
        <tbody>
          {rows.map(({ salary, r }) => (
            <tr>
              <td><a href={`/tax-on-${salary}-in-${province.slug}`}>{money(salary)}</a></td>
              <td>{formatCurrency(r.totalTax)}</td>
              <td>{formatCurrency(r.afterTaxIncome)}</td>
              <td>{formatCurrency(r.afterTaxIncome / 12)}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (
        <>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </>
      ))}

      <h2>Related</h2>
      <ul>
        <li><a href="/rrsp-calculator">RRSP tax savings in {province.name}</a></li>
        <li><a href="/self-employed-tax-calculator">Self-employed tax calculator</a></li>
        <li><a href={`/${year}-canadian-tax-data`}>{year} tax rates for every province</a></li>
      </ul>
    </section>
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: `${province.name} Income Tax Calculator ${year}`,
      url: `https://calctax.ca/${province.slug}-income-tax-calculator`,
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
      description,
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    })}
  />
</Base>
