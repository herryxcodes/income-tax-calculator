---
import Base from "../../layouts/Base.astro";
import PageIntro from "../../components/PageIntro.astro";
import { getCollection } from "astro:content";
import { getTaxYear, DEFAULT_TAX_YEAR } from "../../lib/tax-engine";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.updatedDate ?? b.data.publishDate).valueOf() - (a.data.updatedDate ?? a.data.publishDate).valueOf()
);

// Group by tag so related guides sit together.
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const list = groups.get(post.data.tag) ?? [];
  list.push(post);
  groups.set(post.data.tag, list);
}

const data = getTaxYear(DEFAULT_TAX_YEAR);
const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" });
---

<Base
  title="Canadian Tax Guides — Brackets, RRSP, Self-Employment and More | CalcTax"
  description="Plain-language guides to Canadian income tax: brackets, RRSP, TFSA and FHSA, self-employment, capital gains, deadlines and province-by-province rules."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
    <PageIntro title="Tax guides" lede="Plain-language explanations, each paired with a calculator so you can see your own numbers." />

    <p class="mt-6 max-w-2xl border-l-4 border-l-provincial pl-4 text-ink">
      Returns for {DEFAULT_TAX_YEAR} are due {longDate(data.dates.filingDeadline)}
      ({longDate(data.dates.selfEmployedDeadline)} if you're self-employed).
      <a href="/income-tax-calculator" class="text-brand underline">Estimate your {DEFAULT_TAX_YEAR} tax</a>.
    </p>

    <div class="mt-12 space-y-14">
      {[...groups].map(([tag, list]) => (
        <section aria-labelledby={`tag-${tag}`}>
          <h2 id={`tag-${tag}`} class="font-extrabold text-xl text-ink border-b-2 border-ink pb-2">{tag}</h2>
          <ul class="mt-2 grid gap-x-10 md:grid-cols-2">
            {list.map((post) => (
              <li class="border-b border-rule-soft">
                <a href={`/blog/${post.id}`} class="block py-4 group no-underline">
                  <span class="block font-bold text-ink group-hover:text-brand text-[1.05rem] leading-snug">{post.data.title}</span>
                  <span class="block text-ink-2 text-[0.95rem] mt-1 leading-snug">{post.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
