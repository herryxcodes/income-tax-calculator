---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import RRSPCalculator from "../components/calculators/RRSPCalculator.svelte";
import { calculateTax, emptyInput, formatCurrency, getTaxYear, DEFAULT_TAX_YEAR } from "../lib/tax-engine";

const year = DEFAULT_TAX_YEAR;
const data = getTaxYear(year);
const money = (n: number) => `$${n.toLocaleString("en-CA")}`;
const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" });

const savingsAt = (salary: number) => {
  const base = { ...emptyInput("ontario", year), employmentIncome: salary };
  return calculateTax(base).totalTax - calculateTax({ ...base, rrspContribution: 5000 }).totalTax;
};
const examples = [50000, 100000, 200000].map((s) => ({ salary: s, savings: savingsAt(s) }));

const title = `RRSP Tax Savings Calculator ${year} — See Your Refund by Province | CalcTax`;
const description = `How much tax does an RRSP contribution save? See your ${year} tax savings and real after-tax cost in every province. The ${year} RRSP limit is ${money(data.limits.rrsp)}.`;

const faqs = [
  {
    q: `What is the RRSP contribution limit for ${year}?`,
    a: `18% of your ${year - 1} earned income, up to ${money(data.limits.rrsp)}, plus any unused room from earlier years. Your exact room is on your latest notice of assessment and in CRA My Account. Contributions made by ${longDate(data.dates.rrspDeadline)} can be deducted on your ${year} return.`,
  },
  {
    q: `How much tax will my RRSP contribution save?`,
    a: `Roughly your marginal tax rate times the contribution. In Ontario in ${year}, a $5,000 contribution saves about ${examples.map((e) => `${formatCurrency(e.savings)} at ${money(e.salary)}`).join(", ")}.`,
  },
  {
    q: `Should I contribute to an RRSP or a TFSA?`,
    a: `If you expect a lower tax rate when you withdraw in retirement than you have today, an RRSP usually comes out ahead. If you expect the same or a higher rate, a TFSA usually does, because its withdrawals are never taxed. Saving for a first home? The FHSA gives you both a deduction and tax-free withdrawals.`,
  },
  {
    q: `How do I check my RRSP room?`,
    a: `Log in to CRA My Account or check your most recent notice of assessment. Both show your deduction limit including unused room carried forward.`,
  },
];
---

<Base title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
    <PageIntro
      title="RRSP tax savings calculator"
      lede="See how much tax a contribution saves you, and what it really costs once the refund comes back."
    />
    <div class="mt-8">
      <RRSPCalculator client:load />
    </div>

    <section class="mt-24 prose">
      <h2>How an RRSP lowers your tax</h2>
      <p>
        RRSP contributions are deducted from your income before tax is calculated, so each dollar you contribute saves
        tax at your marginal rate. The money grows tax-free inside the plan and is taxed when you withdraw it, ideally
        in retirement when your rate is lower.
      </p>
      <table>
        <thead><tr><th>Salary (Ontario, {year})</th><th>Tax saved on a $5,000 contribution</th></tr></thead>
        <tbody>
          {examples.map((e) => <tr><td>{money(e.salary)}</td><td>{formatCurrency(e.savings)}</td></tr>)}
        </tbody>
      </table>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (
        <>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </>
      ))}
    </section>
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: `RRSP Tax Savings Calculator ${year}`,
      url: "https://calctax.ca/rrsp-calculator",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
      description,
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    })}
  />
</Base>
