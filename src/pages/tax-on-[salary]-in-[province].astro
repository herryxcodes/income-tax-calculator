---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import DollarSplit from "../components/ui/DollarSplit.svelte";
import Worksheet from "../components/ui/Worksheet.svelte";
import FilingCTA from "../components/ui/FilingCTA.svelte";
import {
  calculateTax,
  emptyInput,
  formatCurrency,
  formatPercent,
  getProvinces,
  getTaxYear,
  DEFAULT_TAX_YEAR,
  type ProvinceTaxData,
} from "../lib/tax-engine";

const SALARIES = [
  25000, 30000, 35000, 40000, 45000, 50000, 55000, 60000, 65000, 70000, 75000, 80000, 85000, 90000, 95000,
  100000, 110000, 120000, 130000, 140000, 150000, 175000, 200000, 250000, 300000,
];

export function getStaticPaths() {
  const salaries = [
    25000, 30000, 35000, 40000, 45000, 50000, 55000, 60000, 65000, 70000, 75000, 80000, 85000, 90000, 95000,
    100000, 110000, 120000, 130000, 140000, 150000, 175000, 200000, 250000, 300000,
  ];
  return getProvinces().flatMap((province) =>
    salaries.map((salary) => ({ params: { salary: String(salary), province: province.slug }, props: { province, salary } }))
  );
}

const { province, salary } = Astro.props as { province: ProvinceTaxData; salary: number };
const year = DEFAULT_TAX_YEAR;
const data = getTaxYear(year);
const run = (slug: string, s: number) => calculateTax({ ...emptyInput(slug, year), employmentIncome: s });
const result = run(province.slug, salary);
const salaryText = `$${salary.toLocaleString("en-CA")}`;
const monthly = result.afterTaxIncome / 12;
const biweekly = result.afterTaxIncome / 26;

const idx = SALARIES.indexOf(salary);
const nearby = SALARIES.slice(Math.max(0, idx - 2), idx + 3).map((s) => ({ salary: s, r: s === salary ? result : run(province.slug, s) }));

const others = ["ontario", "alberta", "bc", "quebec"].filter((s) => s !== province.slug).slice(0, 3);
const comparisons = others.map((slug) => ({ r: run(slug, salary) }));

const title = `Tax on ${salaryText} in ${province.name} (${year}): Take-Home ${formatCurrency(result.afterTaxIncome)} | CalcTax`;
const description = `On a ${salaryText} salary in ${province.name} in ${year}, you pay ${formatCurrency(result.totalTax)} in tax, CPP and EI and take home ${formatCurrency(result.afterTaxIncome)} (${formatCurrency(monthly)} a month). See every line.`;
const calcLink = `/${province.slug}-income-tax-calculator?income=${salary}&prov=${province.slug}&year=${year}`;
---

<Base title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
    <PageIntro
      title={`Tax on ${salaryText} in ${province.name}`}
      crumbs={[{ href: `/${province.slug}-income-tax-calculator`, label: province.name }, { label: salaryText }]}
    />

    <p class="blank-sentence text-ink mt-8 max-w-4xl">
      On {salaryText} a year in {province.name}, you take home {formatCurrency(result.afterTaxIncome)}.
    </p>
    <p class="text-lg sm:text-xl text-ink-2 mt-4 max-w-2xl">
      That's {formatCurrency(monthly)} a month or {formatCurrency(biweekly)} every two weeks in {year}, after
      {" "}{formatCurrency(result.totalTax)} in income tax and payroll contributions. Your marginal rate is
      {" "}{formatPercent(result.marginalRate, 1)}.
    </p>
    {data.status === "projected" && <p class="mt-3 max-w-2xl text-[0.95rem] text-ink-2 border-l-4 border-l-provincial pl-3">{data.statusNote}</p>}

    <DollarSplit {result} />

    <div class="mt-12 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Worksheet {result} />
      </div>
      <div class="lg:col-span-5 space-y-8">
        <div>
          <a class="btn btn-primary" href={calcLink}>Change the numbers in the calculator</a>
          <p class="text-sm text-ink-3 mt-2">Add RRSP contributions, side income or investments.</p>
        </div>

        <section aria-labelledby="nearby">
          <h2 id="nearby" class="font-extrabold text-lg text-ink">Other salaries in {province.name}</h2>
          <table class="w-full text-[0.95rem] mt-3">
            <thead>
              <tr class="text-left text-ink-2 border-b-2 border-ink">
                <th class="py-2 pr-3 font-bold">Salary</th>
                <th class="py-2 pr-3 font-bold text-right">Take-home</th>
                <th class="py-2 font-bold text-right">Average rate</th>
              </tr>
            </thead>
            <tbody>
              {nearby.map(({ salary: s, r }) => (
                <tr class:list={["border-b border-rule-soft", s === salary && "bg-field font-bold"]}>
                  <td class="py-2 pr-3">
                    {s === salary ? <span>${s.toLocaleString("en-CA")}</span> : <a class="text-brand underline decoration-brand/30" href={`/tax-on-${s}-in-${province.slug}`}>${s.toLocaleString("en-CA")}</a>}
                  </td>
                  <td class="py-2 pr-3 text-right figure">{formatCurrency(r.afterTaxIncome)}</td>
                  <td class="py-2 text-right figure">{formatPercent(r.averageRate, 1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section aria-labelledby="elsewhere">
          <h2 id="elsewhere" class="font-extrabold text-lg text-ink">{salaryText} in other provinces</h2>
          <table class="w-full text-[0.95rem] mt-3">
            <thead>
              <tr class="text-left text-ink-2 border-b-2 border-ink">
                <th class="py-2 pr-3 font-bold">Province</th>
                <th class="py-2 pr-3 font-bold text-right">Take-home</th>
                <th class="py-2 font-bold text-right">Difference</th>
              </tr>
            </thead>
            <tbody>
              {comparisons.map(({ r }) => {
                const diff = r.afterTaxIncome - result.afterTaxIncome;
                return (
                  <tr class="border-b border-rule-soft">
                    <td class="py-2 pr-3">
                      <a class="text-brand underline decoration-brand/30" href={`/tax-on-${salary}-in-${r.province.slug}`}>{r.province.name}</a>
                    </td>
                    <td class="py-2 pr-3 text-right figure">{formatCurrency(r.afterTaxIncome)}</td>
                    <td class="py-2 text-right figure">{diff >= 0 ? "+" : "−"}{formatCurrency(Math.abs(diff))}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <p class="text-sm text-ink-3 mt-2">Difference in take-home pay compared with {province.name}.</p>
        </section>

        <FilingCTA />
      </div>
    </div>

    <p class="mt-12 max-w-3xl text-sm text-ink-3 leading-relaxed">
      Employment income only, for a single person under 65 with no dependants and no other deductions, using {year}
      rates. <a class="underline" href="/disclaimer">Read the disclaimer</a>.
    </p>
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: `How much tax do I pay on ${salaryText} in ${province.name}?`,
          acceptedAnswer: {
            "@type": "Answer",
            text: `On a ${salaryText} salary in ${province.name} in ${year}, you pay about ${formatCurrency(result.federalTax)} in federal tax, ${formatCurrency(result.provincialTax)} in ${province.name} tax and ${formatCurrency(result.contributions.total)} in payroll contributions, ${formatCurrency(result.totalTax)} in total. Your average rate is ${formatPercent(result.averageRate, 1)}.`,
          },
        },
        {
          "@type": "Question",
          name: `What is the take-home pay on ${salaryText} in ${province.name}?`,
          acceptedAnswer: {
            "@type": "Answer",
            text: `About ${formatCurrency(result.afterTaxIncome)} a year in ${year}, which is ${formatCurrency(monthly)} a month or ${formatCurrency(biweekly)} every two weeks.`,
          },
        },
      ],
    })}
  />
</Base>
