---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";

const code = `<iframe
  src="https://calctax.ca/widget"
  title="Canadian income tax calculator by CalcTax"
  width="100%"
  height="560"
  loading="lazy"
  style="border: 1px solid #cdd3ea; border-radius: 8px;"
></iframe>
<p style="font-size: 13px; margin-top: 6px;">
  Income tax calculator by <a href="https://calctax.ca">CalcTax.ca</a>
</p>`;
---

<Base
  title="Embed a Free Canadian Tax Calculator on Your Website | CalcTax"
  description="Add a free Canadian take-home pay calculator to your website or blog. One iframe, no signup, no API key, always updated for the current tax year."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
    <PageIntro
      title="Embed the calculator on your site"
      lede="Give your readers a take-home pay calculator for every province. Paste one snippet; we keep the rates up to date."
    />

    <div class="mt-10 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5 space-y-6">
        <div class="prose">
          <h2 class="!mt-0">Embed code</h2>
          <p>Paste this into any page that accepts HTML. Please keep the credit line under the frame.</p>
        </div>
        <pre class="sheet p-4 overflow-x-auto text-sm figure text-ink whitespace-pre"><code id="embed-code">{code}</code></pre>
        <button type="button" id="copy-embed" class="btn btn-primary">Copy embed code</button>
        <div class="prose">
          <h2>Good to know</h2>
          <ul>
            <li>Free for blogs, newsletters, employers, accountants and news sites.</li>
            <li>Calculations run in your visitor's browser. Nothing they type is sent to us or to you.</li>
            <li>Rates are updated every tax year without you changing anything.</li>
            <li>Want a version in your brand colours or with your own call to action? <a href="/contact">Get in touch</a>.</li>
          </ul>
        </div>
      </div>
      <div class="lg:col-span-7">
        <p class="text-sm font-bold text-ink-2 mb-2">Preview</p>
        <iframe
          src="/widget"
          title="Preview of the embedded calculator"
          width="100%"
          height="560"
          loading="lazy"
          class="border border-rule rounded-lg bg-sheet"
        ></iframe>
      </div>
    </div>
  </div>

  <script>
    const btn = document.getElementById("copy-embed");
    btn?.addEventListener("click", async () => {
      const text = document.getElementById("embed-code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = "Copy embed code"), 2000);
      } catch {
        window.prompt("Copy this code", text);
      }
    });
  </script>
</Base>
