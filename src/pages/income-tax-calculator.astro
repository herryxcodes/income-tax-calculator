---
import Base from "../layouts/Base.astro";
import IncomeTaxCalculator from "../components/calculators/IncomeTaxCalculator.svelte";
import IncomeTaxExplainer from "../components/IncomeTaxExplainer.astro";
import PageIntro from "../components/PageIntro.astro";
import { DEFAULT_TAX_YEAR } from "../lib/tax-engine";

const title = `Income Tax Calculator Canada ${DEFAULT_TAX_YEAR} — Federal + Provincial | CalcTax`;
const description = `Free ${DEFAULT_TAX_YEAR} Canadian income tax calculator. Federal and provincial tax, CPP, EI, RRSP and FHSA deductions, investment income, and a comparison of all 13 provinces. No signup.`;
---

<Base title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
    <PageIntro
      title="Income tax calculator"
      lede="Add RRSP and FHSA deductions, side income, capital gains and dividends, then compare every province."
    />
    <div class="mt-8">
      <IncomeTaxCalculator client:load />
    </div>
    <div class="mt-24">
      <IncomeTaxExplainer />
    </div>
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: `Income Tax Calculator Canada ${DEFAULT_TAX_YEAR}`,
      url: "https://calctax.ca/income-tax-calculator",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
      description,
    })}
  />
</Base>
