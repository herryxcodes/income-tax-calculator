---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import SelfEmployedCalculator from "../components/calculators/SelfEmployedCalculator.svelte";
import { calculateTax, emptyInput, formatCurrency, formatRate, getTaxYear, DEFAULT_TAX_YEAR } from "../lib/tax-engine";

const year = DEFAULT_TAX_YEAR;
const data = getTaxYear(year);
const { cpp } = data;
const money = (n: number) => `$${n.toLocaleString("en-CA")}`;
const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString("en-CA", { month: "long", day: "numeric", year: "numeric" });
const seRate = formatRate(2 * (cpp.baseRate + cpp.firstAdditionalRate));
const se2Rate = formatRate(2 * cpp.secondAdditionalRate);
const seMax = 2 * ((cpp.ympe - cpp.basicExemption) * (cpp.baseRate + cpp.firstAdditionalRate) + (cpp.yampe - cpp.ympe) * cpp.secondAdditionalRate);
const example = calculateTax({ ...emptyInput("ontario", year), selfEmploymentIncome: 60000 });
const exampleShare = example.totalTax / 60000;

const title = `Self-Employed Tax Calculator Canada ${year} — CPP, Instalments, GST/HST | CalcTax`;
const description = `Estimate ${year} tax for freelancers and sole proprietors in Canada: both halves of CPP, federal and provincial tax, how much to set aside, quarterly instalments and GST/HST registration.`;

const faqs = [
  {
    q: `How much CPP do self-employed people pay in ${year}?`,
    a: `You pay both the employee and employer share: ${seRate} of net self-employment earnings between ${money(cpp.basicExemption)} and ${money(cpp.ympe)}, plus ${se2Rate} on earnings from ${money(cpp.ympe)} to ${money(cpp.yampe)}. The most you can pay is ${formatCurrency(seMax)}. Half is deductible, and part of the other half earns a tax credit.`,
  },
  {
    q: `How much should I set aside for taxes?`,
    a: `It depends on your profit and province. In Ontario, ${formatCurrency(60000)} of profit in ${year} costs about ${formatCurrency(example.totalTax)} in income tax and CPP, or ${Math.round(exampleShare * 100)}% of profit. The calculator gives you a percentage of revenue to set aside from every invoice.`,
  },
  {
    q: `When do self-employed people have to file?`,
    a: `For the ${year} tax year you have until ${longDate(data.dates.selfEmployedDeadline)} to file, but any balance owing is due ${longDate(data.dates.balanceDue)}. Interest starts after that date.`,
  },
  {
    q: `Do I need to pay EI as a self-employed person?`,
    a: `No. EI is optional for self-employed people. You can opt in to EI special benefits (maternity, parental, sickness and caregiving), but not regular benefits. The calculator assumes you haven't opted in.`,
  },
];
---

<Base title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
    <PageIntro
      title="Self-employed tax calculator"
      lede="For freelancers, contractors and sole proprietors: what you owe, what to set aside and when to pay."
    />
    <div class="mt-8">
      <SelfEmployedCalculator client:load />
    </div>

    <section class="mt-24 prose">
      <h2>How self-employment is taxed</h2>
      <p>
        Business profit is taxed at the same federal and provincial rates as a salary. The differences are CPP, which
        you pay both halves of, EI, which is optional, and timing: nobody withholds tax from your invoices, so you pay
        it when you file or in quarterly instalments.
      </p>
      <p>
        You report revenue and expenses on form T2125. Common deductible expenses include the business part of your
        home, vehicle and phone, software and subscriptions, professional fees, advertising, insurance, and 50% of
        business meals.
      </p>

      <h2>GST/HST registration</h2>
      <p>
        Once your taxable revenue passes $30,000 in any four consecutive calendar quarters, you must register for and
        charge GST/HST (and QST in Quebec). Below that you're a small supplier and registering is optional.
      </p>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (
        <>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </>
      ))}
      <h3>Should I incorporate?</h3>
      <p>
        Most freelancers start as sole proprietors. Incorporating can lower tax when the business earns more than you
        need to live on, because profit left in the corporation is taxed at the small business rate. It also adds
        accounting costs, so get advice from an accountant first.
      </p>
    </section>
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      name: `Self-Employed Tax Calculator Canada ${year}`,
      url: "https://calctax.ca/self-employed-tax-calculator",
      applicationCategory: "FinanceApplication",
      operatingSystem: "Any",
      offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
      description,
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    })}
  />
</Base>
