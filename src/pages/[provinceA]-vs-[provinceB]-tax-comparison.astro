---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import FilingCTA from "../components/ui/FilingCTA.svelte";
import {
  calculateTax,
  emptyInput,
  formatCurrency,
  formatPercent,
  getProvinceBySlug,
  topMarginalRate,
  DEFAULT_TAX_YEAR,
  type ProvinceTaxData,
} from "../lib/tax-engine";

export function getStaticPaths() {
  const pairs = [
    ["ontario", "alberta"],
    ["ontario", "bc"],
    ["ontario", "quebec"],
    ["alberta", "bc"],
    ["alberta", "quebec"],
    ["bc", "quebec"],
    ["ontario", "manitoba"],
    ["ontario", "saskatchewan"],
    ["alberta", "saskatchewan"],
    ["bc", "alberta"],
    ["quebec", "bc"],
    ["ontario", "nova-scotia"],
    ["ontario", "new-brunswick"],
    ["alberta", "ontario"],
    ["quebec", "ontario"],
  ];
  return pairs.map(([a, b]) => ({
    params: { provinceA: a, provinceB: b },
    props: { provA: getProvinceBySlug(a)!, provB: getProvinceBySlug(b)! },
  }));
}

const { provA, provB } = Astro.props as { provA: ProvinceTaxData; provB: ProvinceTaxData };
const year = DEFAULT_TAX_YEAR;
const salaries = [50000, 75000, 100000, 150000, 200000];
const run = (slug: string, s: number) => calculateTax({ ...emptyInput(slug, year), employmentIncome: s });
const rows = salaries.map((s) => {
  const a = run(provA.slug, s);
  const b = run(provB.slug, s);
  return { salary: s, a, b, diff: a.afterTaxIncome - b.afterTaxIncome };
});
const at75 = rows.find((r) => r.salary === 75000)!;
const better = at75.diff >= 0 ? provA : provB;
const worse = better === provA ? provB : provA;
const gap = Math.abs(at75.diff);
const money = (n: number) => `$${n.toLocaleString("en-CA")}`;

const title = `${provA.name} vs ${provB.name} Income Tax (${year}): Who Keeps More? | CalcTax`;
const description = `Compare ${year} take-home pay in ${provA.name} and ${provB.name} at $50K, $75K, $100K, $150K and $200K salaries, including federal and provincial tax, CPP/QPP and EI.`;

const breakdown = [
  { label: "Federal tax", a: at75.a.federalTax, b: at75.b.federalTax },
  { label: "Provincial tax", a: at75.a.provincialTax, b: at75.b.provincialTax },
  { label: "CPP/QPP", a: at75.a.cppContributions + at75.a.cpp2Contributions, b: at75.b.cppContributions + at75.b.cpp2Contributions },
  { label: "EI and QPIP", a: at75.a.eiPremiums + at75.a.qpipPremiums, b: at75.b.eiPremiums + at75.b.qpipPremiums },
];
---

<Base title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
    <PageIntro title={`${provA.name} vs ${provB.name}: income tax compared`} crumbs={[{ label: `${provA.abbreviation} vs ${provB.abbreviation}` }]} />

    <p class="blank-sentence text-ink mt-8 max-w-4xl">
      On a $75,000 salary, you keep {formatCurrency(gap)} more a year in {better.name}.
    </p>
    <p class="text-lg sm:text-xl text-ink-2 mt-4 max-w-2xl">
      That's {formatCurrency(gap / 12)} a month compared with {worse.name}, using {year} federal and provincial tax,
      {" "}{provA.slug === "quebec" || provB.slug === "quebec" ? "CPP/QPP, EI and QPIP" : "CPP and EI"}.
    </p>

    <div class="mt-12 grid gap-10 lg:grid-cols-12">
      <section class="lg:col-span-7 sheet overflow-x-auto" aria-labelledby="by-salary">
        <h2 id="by-salary" class="px-6 pt-5 pb-3 font-extrabold text-lg text-ink">Take-home pay by salary</h2>
        <table class="w-full text-[0.95rem] min-w-[520px]">
          <thead>
            <tr class="text-left text-ink-2 border-b-2 border-ink">
              <th class="py-2.5 px-6 font-bold">Salary</th>
              <th class="py-2.5 px-3 font-bold text-right">{provA.name}</th>
              <th class="py-2.5 px-3 font-bold text-right">{provB.name}</th>
              <th class="py-2.5 px-6 font-bold text-right">You keep more in</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(({ salary, a, b, diff }) => (
              <tr class="border-b border-rule-soft last:border-b-0">
                <td class="py-2.5 px-6 figure">
                  <a class="text-brand underline decoration-brand/30" href={`/tax-on-${salary}-in-${provA.slug}`}>{money(salary)}</a>
                </td>
                <td class="py-2.5 px-3 text-right figure">{formatCurrency(a.afterTaxIncome)}</td>
                <td class="py-2.5 px-3 text-right figure">{formatCurrency(b.afterTaxIncome)}</td>
                <td class="py-2.5 px-6 text-right">
                  {Math.abs(diff) < 1 ? "Same" : <><span class="font-bold">{diff > 0 ? provA.abbreviation : provB.abbreviation}</span> <span class="figure text-ink-2">+{formatCurrency(Math.abs(diff))}</span></>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="px-6 py-4 text-sm text-ink-3">Employment income with no deductions, {year} rates.</p>
      </section>

      <section class="lg:col-span-5 sheet" aria-labelledby="at-75">
        <h2 id="at-75" class="px-6 pt-5 pb-3 font-extrabold text-lg text-ink">Where the money goes at $75,000</h2>
        <table class="w-full text-[0.95rem]">
          <thead>
            <tr class="text-left text-ink-2 border-b-2 border-ink">
              <th class="py-2.5 px-6 font-normal"><span class="sr-only">Item</span></th>
              <th class="py-2.5 px-3 font-bold text-right">{provA.abbreviation}</th>
              <th class="py-2.5 px-6 font-bold text-right">{provB.abbreviation}</th>
            </tr>
          </thead>
          <tbody class="figure">
            {breakdown.map((row) => (
              <tr class="border-b border-rule-soft">
                <th scope="row" class="py-2.5 px-6 text-left font-normal font-sans text-ink-2">{row.label}</th>
                <td class="py-2.5 px-3 text-right">{formatCurrency(row.a)}</td>
                <td class="py-2.5 px-6 text-right">{formatCurrency(row.b)}</td>
              </tr>
            ))}
            <tr class="border-t-2 border-ink font-bold text-ink">
              <th scope="row" class="py-2.5 px-6 text-left font-sans">Take-home</th>
              <td class="py-2.5 px-3 text-right">{formatCurrency(at75.a.afterTaxIncome)}</td>
              <td class="py-2.5 px-6 text-right">{formatCurrency(at75.b.afterTaxIncome)}</td>
            </tr>
          </tbody>
        </table>
      </section>
    </div>

    <section class="prose mt-16">
      <h2>What drives the difference</h2>
      <ul>
        <li>
          <strong>Basic personal amount:</strong> {money(provA.basicPersonalAmount)} in {provA.name} and
          {" "}{money(provB.basicPersonalAmount)} in {provB.name}. A higher amount means less provincial tax on lower incomes.
        </li>
        <li>
          <strong>Brackets:</strong> {provA.name} has {provA.brackets.length} provincial brackets starting at
          {" "}{formatPercent(provA.brackets[0].rate)}; {provB.name} has {provB.brackets.length}, starting at
          {" "}{formatPercent(provB.brackets[0].rate)}.
        </li>
        <li>
          <strong>Top combined rate:</strong> {formatPercent(topMarginalRate(provA.slug, year))} in {provA.name} and
          {" "}{formatPercent(topMarginalRate(provB.slug, year))} in {provB.name}.
        </li>
      </ul>
      <p>
        Income tax is only part of the cost of living. Sales tax, housing, childcare and provincial benefits also differ.
        Try your own numbers in the <a href={`/${provA.slug}-income-tax-calculator`}>{provA.name}</a> or
        {" "}<a href={`/${provB.slug}-income-tax-calculator`}>{provB.name}</a> calculator.
      </p>
    </section>

    <div class="mt-10 max-w-2xl">
      <FilingCTA />
    </div>
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: `Is ${provA.name} or ${provB.name} better for taxes?`,
          acceptedAnswer: {
            "@type": "Answer",
            text: `At a $75,000 salary in ${year}, take-home pay is ${formatCurrency(gap)} higher in ${better.name}. The gap changes with income; at $150,000 it's ${formatCurrency(Math.abs(rows[3].diff))} in favour of ${rows[3].diff >= 0 ? provA.name : provB.name}.`,
          },
        },
      ],
    })}
  />
</Base>
