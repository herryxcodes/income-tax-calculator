---
interface Crumb {
  href?: string;
  label: string;
}
interface Props {
  title: string;
  lede?: string;
  crumbs?: Crumb[];
}
const { title, lede, crumbs = [] } = Astro.props;
---

<div class="max-w-3xl">
  {crumbs.length > 0 && (
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-ink-3">
      <ol class="flex flex-wrap items-center gap-x-2">
        <li><a href="/" class="hover:text-brand">Home</a></li>
        {crumbs.map((c) => (
          <li class="flex items-center gap-2">
            <span aria-hidden="true">/</span>
            {c.href ? <a href={c.href} class="hover:text-brand">{c.label}</a> : <span aria-current="page" class="text-ink-2">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
  )}
  <h1 class="text-[1.75rem] sm:text-[2.1rem] leading-tight font-extrabold tracking-tight text-ink">{title}</h1>
  {lede && <p class="mt-3 text-lg text-ink-2 max-w-2xl">{lede}</p>}
  <slot />
</div>
