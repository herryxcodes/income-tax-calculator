---
import "../styles/global.css";
import { DEFAULT_TAX_YEAR } from "../data/tax-rates";

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const siteUrl = "https://calctax.ca";
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const path = Astro.url.pathname;

const nav = [
  { href: "/income-tax-calculator", label: "Income tax" },
  { href: "/rrsp-calculator", label: "RRSP" },
  { href: "/self-employed-tax-calculator", label: "Self-employed" },
  { href: `/${DEFAULT_TAX_YEAR}-canadian-tax-data`, label: "Rates" },
  { href: "/blog", label: "Guides" },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + "/");

const provinceLinks = [
  ["ontario", "Ontario"],
  ["quebec", "Quebec"],
  ["bc", "British Columbia"],
  ["alberta", "Alberta"],
  ["manitoba", "Manitoba"],
  ["saskatchewan", "Saskatchewan"],
  ["nova-scotia", "Nova Scotia"],
  ["new-brunswick", "New Brunswick"],
];
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f3f5fb" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;500;700&family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,500;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="CalcTax" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content="https://calctax.ca/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://calctax.ca/og.png" />

    <link rel="alternate" hreflang="en-CA" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "CalcTax",
        url: siteUrl,
        description: "Free, privacy-first Canadian income tax calculators.",
        logo: `${siteUrl}/apple-touch-icon.png`,
        contactPoint: {
          "@type": "ContactPoint",
          email: "hello@calctax.ca",
          contactType: "customer service",
          availableLanguage: "English",
        },
      })}
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-sheet focus:px-4 focus:py-2 focus:rounded"
    >Skip to content</a>

    <header class="border-b border-rule bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/80 sticky top-0 z-40">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-6" aria-label="Main">
        <a href="/" class="flex items-center gap-2.5 font-extrabold text-xl tracking-tight text-ink no-underline">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          CalcTax
        </a>

        <ul class="hidden md:flex items-center gap-1 text-[0.95rem]">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class:list={[
                  "px-3 py-2 rounded-full no-underline transition-colors",
                  isCurrent(item.href)
                    ? "bg-field text-ink font-bold"
                    : "text-ink-2 hover:text-ink hover:bg-field",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <button
          type="button"
          id="menu-toggle"
          class="md:hidden -mr-2 p-2 rounded-full text-ink hover:bg-field"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </nav>

      <div id="mobile-menu" class="hidden md:hidden border-t border-rule-soft">
        <ul class="max-w-6xl mx-auto px-4 py-3 grid gap-1">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class:list={[
                  "block px-3 py-2.5 rounded-lg no-underline",
                  isCurrent(item.href) ? "bg-field font-bold text-ink" : "text-ink-2",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-rule bg-sheet">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 grid gap-10 md:grid-cols-[1.4fr_1fr_1.2fr_1fr] text-[0.95rem]">
        <div>
          <a href="/" class="flex items-center gap-2.5 font-extrabold text-lg text-ink no-underline">
            <img src="/favicon.svg" alt="" width="24" height="24" />
            CalcTax
          </a>
          <p class="mt-3 text-ink-2 max-w-[30ch]">
            Free Canadian tax calculators. Everything is calculated in your browser, so your numbers stay on your device.
          </p>
        </div>
        <div>
          <h2 class="font-bold text-ink mb-3">Calculators</h2>
          <ul class="space-y-2 text-ink-2">
            <li><a href="/income-tax-calculator" class="hover:text-brand">Income tax</a></li>
            <li><a href="/rrsp-calculator" class="hover:text-brand">RRSP tax savings</a></li>
            <li><a href="/self-employed-tax-calculator" class="hover:text-brand">Self-employed</a></li>
            <li><a href="/embed" class="hover:text-brand">Embed on your site</a></li>
          </ul>
        </div>
        <div>
          <h2 class="font-bold text-ink mb-3">By province</h2>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-ink-2">
            {provinceLinks.map(([slug, name]) => (
              <li><a href={`/${slug}-income-tax-calculator`} class="hover:text-brand">{name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="font-bold text-ink mb-3">About</h2>
          <ul class="space-y-2 text-ink-2">
            <li><a href="/about" class="hover:text-brand">How it works</a></li>
            <li><a href="/contact" class="hover:text-brand">Contact</a></li>
            <li><a href="/privacy" class="hover:text-brand">Privacy</a></li>
            <li><a href="/terms" class="hover:text-brand">Terms</a></li>
            <li><a href="/disclaimer" class="hover:text-brand">Disclaimer</a></li>
            <li><a href="/disclosure" class="hover:text-brand">Affiliate disclosure</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-rule-soft">
        <p class="max-w-6xl mx-auto px-4 sm:px-6 py-5 text-sm text-ink-3">
          &copy; {new Date().getFullYear()} CalcTax. Estimates only, not tax advice.
          Not affiliated with the Canada Revenue Agency or Revenu Québec.
        </p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("mobile-menu");
      toggle?.addEventListener("click", () => {
        const open = menu?.classList.toggle("hidden") === false;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      });
    </script>
  </body>
</html>
