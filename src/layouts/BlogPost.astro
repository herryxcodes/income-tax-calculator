---
import Base from "./Base.astro";
import FilingCTA from "../components/ui/FilingCTA.svelte";

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  tag: string;
  tagColor: string;
  calculatorLink: string;
}

const { title, description, publishDate, updatedDate, tag, calculatorLink } = Astro.props;

const calculatorNames: Record<string, string> = {
  "/income-tax-calculator": "income tax calculator",
  "/rrsp-calculator": "RRSP calculator",
  "/self-employed-tax-calculator": "self-employed calculator",
};

const fmt = (d: Date) => d.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const siteUrl = "https://calctax.ca";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<Base title={`${title} | CalcTax`} description={description}>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 sm:pt-14">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-ink-3">
      <ol class="flex flex-wrap items-center gap-x-2">
        <li><a href="/" class="hover:text-brand">Home</a></li>
        <li class="flex items-center gap-2"><span aria-hidden="true">/</span><a href="/blog" class="hover:text-brand">Guides</a></li>
      </ol>
    </nav>

    <header class="max-w-3xl">
      <p class="text-sm font-bold text-ink-2">{tag}</p>
      <h1 class="mt-2 text-[1.9rem] sm:text-[2.5rem] leading-[1.12] font-extrabold tracking-tight text-ink">{title}</h1>
      <p class="mt-4 text-lg text-ink-2">{description}</p>
      <p class="mt-4 text-sm text-ink-3">
        Published <time datetime={publishDate.toISOString()}>{fmt(publishDate)}</time>{updatedDate && (
          <>, updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></>
        )}
      </p>
    </header>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,68ch)_1fr]">
      <div class="prose">
        <slot />
      </div>

      <aside class="space-y-5 lg:pt-1">
        <div class="lg:sticky lg:top-24 space-y-5">
          <div class="sheet p-5">
            <p class="font-bold text-ink">Run your own numbers</p>
            <p class="text-ink-2 text-[0.95rem] mt-1">Every line of your federal and provincial tax, in your browser.</p>
            <a href={calculatorLink} class="btn btn-primary mt-4">Open the {calculatorNames[calculatorLink] ?? "calculator"}</a>
          </div>
          <FilingCTA />
        </div>
      </aside>
    </div>

    <p class="mt-12 max-w-3xl text-sm text-ink-3">
      This article is general information, not tax advice. Figures can change when governments update rates.
      <a href="/disclaimer" class="underline">Read the disclaimer</a>.
    </p>
  </article>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      datePublished: publishDate.toISOString(),
      dateModified: (updatedDate || publishDate).toISOString(),
      author: { "@type": "Organization", name: "CalcTax", url: siteUrl },
      publisher: { "@type": "Organization", name: "CalcTax", url: siteUrl },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
        { "@type": "ListItem", position: 2, name: "Guides", item: siteUrl + "/blog" },
        { "@type": "ListItem", position: 3, name: title, item: canonicalUrl },
      ],
    })}
  />
</Base>
